-- ESP
-- =====================================================================
local ESPCache, HighlightCache = {}, {}
local Tracers = {}

local function GetTeamColor(player)
    if player and player.Team then
        local color = _G.Settings.TeamColors[player.Team.Name]
        if color then return color end
    end
    return Color3.fromRGB(255, 255, 255)
end

local function CreateCartoonBox(char)
    if HighlightCache[char] then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "ENT8CartoonHighlight"
    highlight.FillColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.9
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.OutlineTransparency = 0
    highlight.Adornee = char
    highlight.Parent = char
    HighlightCache[char] = highlight
end

local function UpdateESP(char, text, color, tag, show, hum)
    if not show then 
        if ESPCache[char] and ESPCache[char][tag] then ESPCache[char][tag].Enabled = false end 
        return 
    end
    
    local cache = ESPCache[char]
    if not cache then cache = {} ESPCache[char] = cache end
    local bill = cache[tag]
    
    if not bill then
        local root = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        
        bill = Instance.new("BillboardGui")
        bill.Name = tag
        bill.Adornee = root
        bill.AlwaysOnTop = true
        bill.Size = UDim2.new(0, 200, 0, 60)
        bill.StudsOffset = Vector3.new(0, 3.5, 0)
        bill.Parent = root
        
        local label = Instance.new("TextLabel")
        label.Name = "TextL"
        label.Parent = bill
        label.Text = ""
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 0, 20)
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.Font = Enum.Font.GothamBlack
        label.TextColor3 = color
        
        local hpBg = Instance.new("Frame")
        hpBg.Name = "HPBg"
        hpBg.Size = UDim2.new(0.7, 0, 0, 6)
        hpBg.Position = UDim2.new(0.15, 0, 0, 22)
        hpBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        hpBg.BorderSizePixel = 0
        hpBg.Visible = false
        hpBg.Parent = bill
        
        local cornerBg = Instance.new("UICorner")
        cornerBg.CornerRadius = UDim.new(1, 0)
        cornerBg.Parent = hpBg
        
        local strokeBg = Instance.new("UIStroke")
        strokeBg.Color = Color3.new(0, 0, 0)
        strokeBg.Thickness = 1.5
        strokeBg.Parent = hpBg
        
        local hpFill = Instance.new("Frame")
        hpFill.Name = "HPFill"
        hpFill.Size = UDim2.new(1, 0, 1, 0)
        hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        hpFill.BorderSizePixel = 0
        hpFill.Parent = hpBg
        
        local cornerFill = Instance.new("UICorner")
        cornerFill.CornerRadius = UDim.new(1, 0)
        cornerFill.Parent = hpFill
        
        cache[tag] = bill
    end
    
    bill.Enabled = true
    local label = bill:FindFirstChild("TextL")
    if label then 
        label.TextSize = _G.Settings.TextSize 
        label.TextColor3 = color 
        label.Text = text 
    end
    
    local hpBg = bill:FindFirstChild("HPBg")
    if hpBg and hum then
        hpBg.Visible = _G.Settings.PlayerHealthBar
        local hpFill = hpBg:FindFirstChild("HPFill")
        if hpFill then
            local percent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            hpFill.Size = UDim2.new(percent, 0, 1, 0)
            
            if percent > 0.7 then
                hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
            elseif percent > 0.3 then
                hpFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            else
                hpFill.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            end
        end
    end
end

local function UpdateTracer(player, color)
    local char = player.Character
    if not char or not _G.Settings.ShowTracer then
        if Tracers[player] then Tracers[player].Visible = false end
        return
    end
    local root = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not root then
        if Tracers[player] then Tracers[player].Visible = false end
        return
    end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen then
        if Tracers[player] then Tracers[player].Visible = false end
        return
    end
    
    if not Tracers[player] then
        Tracers[player] = Drawing.new("Line")
        Tracers[player].Thickness = 2
        Tracers[player].Transparency = 0.2
        Tracers[player].Visible = false
    end
    
    local tracer = Tracers[player]
    tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    tracer.To = Vector2.new(screenPos.X, screenPos.Y)
    tracer.Color = color
    tracer.Visible = true
end

local function CleanupPlayer(player)
    if not player then return end
    local char = player.Character
    if char then
        if ESPCache[char] then for _, bill in pairs(ESPCache[char]) do bill:Destroy() end ESPCache[char] = nil end
        if HighlightCache[char] then HighlightCache[char]:Destroy() HighlightCache[char] = nil end
    end
    if Tracers[player] then Tracers[player]:Remove() Tracers[player] = nil end
end

local function UpdatePlayerESP()
    if not _G.Settings.PlayerESP then
        for char, _ in pairs(ESPCache) do local p = char.Parent and Players:FindFirstChild(char.Parent.Name) if p then CleanupPlayer(p) end end
        return
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character ~= LocalPlayer.Character then
            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local rp = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            if rp and hum and hum.Health > 0 then
                local dist = math.floor((Camera.CFrame.Position - rp.Position).Magnitude)
                if dist > _G.Settings.ESPRange then CleanupPlayer(p) continue end
                
                local show = _G.Settings.PlayerName or _G.Settings.PlayerDistance or _G.Settings.PlayerHealthBar
                local text = ""
                if _G.Settings.PlayerName then text = p.Name end
                if _G.Settings.PlayerDistance then text = text .. (text ~= "" and " " or "") .. "[" .. dist .. "m]" end
                
                local color = GetTeamColor(p)
                UpdateESP(char, text, color, "ENT8ESP", show, hum)
                
                if _G.Settings.PlayerBox then
                    CreateCartoonBox(char)
                    if HighlightCache[char] then
                        HighlightCache[char].OutlineColor = color
                        HighlightCache[char].FillColor = color
                    end
                else
                    if HighlightCache[char] then HighlightCache[char].Enabled = false end
                end
                
                UpdateTracer(p, color)
            else 
                CleanupPlayer(p) 
            end
        end
    end
end

