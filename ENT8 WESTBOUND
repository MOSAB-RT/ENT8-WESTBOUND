local AimWhitelist = {}
local AimBlacklist = {}

local function IsWhitelisted(player) return player and AimWhitelist[player.Name:lower()] end
local function IsBlacklisted(player) return player and AimBlacklist[player.Name:lower()] end
local function IsCivilian(player) return player and player.Team and player.Team.Name == "Civilians" end

local _target = nil

local function IsVis(tp)
    if not tp then return false end
    local c = LocalPlayer.Character
    if not c or not c:FindFirstChild("Head") then return false end
    local p = RaycastParams.new()
    p.FilterDescendantsInstances = {c}
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.IgnoreWater = true
    local r = workspace:Raycast(Camera.CFrame.Position, tp.Position - Camera.CFrame.Position, p)
    return r and r.Instance:IsDescendantOf(tp.Parent) or (r == nil)
end

-- =====================================================================
-- Target Selection Loop
-- =====================================================================
task.spawn(function()
    while true do
        task.wait(0.05)
        if not _G.Settings.AimPlayers then 
            _target = nil
            continue 
        end
        
        local tp = nil
        local cd = _G.Settings.FOV
        local ctr = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        
        for _, v in ipairs(Players:GetPlayers()) do 
            if v == LocalPlayer then continue end
            if _G.Settings.TeamCheck and v.Team == LocalPlayer.Team then continue end
            if IsCivilian(v) then continue end
            if IsWhitelisted(v) then continue end
            
            local ch = v.Character
            if not ch or ch == LocalPlayer.Character then continue end
            local part = ch:FindFirstChild(_G.Settings.AimPart) or ch:FindFirstChild("HumanoidRootPart")
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if not part or not hum or hum.Health <= 0 then continue end
            if _G.Settings.WallCheck and not IsVis(part) then continue end
            
            local pos, vis = Camera:WorldToViewportPoint(part.Position)
            if vis then
                local mag = (Vector2.new(pos.X, pos.Y) - ctr).Magnitude
                if IsBlacklisted(v) then mag = mag - 10000 end
                if mag < cd then 
                    tp = part
                    cd = mag 
                end
            end
        end
        
        _target = tp
    end
end)

-- =====================================================================
-- Aimbot Logic
-- =====================================================================
local function AimAt(targetPart)
    if not targetPart then return end
    local targetPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
    if not onScreen then return end
    
    local velocity = targetPart.Velocity or Vector3.new(0, 0, 0)
    local distance = (targetPart.Position - Camera.CFrame.Position).Magnitude
    local travelTime = distance / 1000
    local predictedPos = targetPart.Position + (velocity * travelTime * _G.Settings.Prediction)
    
    local predictedScreenPos, _ = Camera:WorldToViewportPoint(predictedPos)
    local screenCenter = Camera.ViewportSize / 2
    local deltaX = predictedScreenPos.X - screenCenter.X
    local deltaY = predictedScreenPos.Y - screenCenter.Y
    
    local smoothFactor = _G.Settings.Smoothness
    local sensitivity = _G.Settings.MouseSensitivity
    pcall(function() mousemoverel(deltaX * smoothFactor * sensitivity, deltaY * smoothFactor * sensitivity) end)
end

