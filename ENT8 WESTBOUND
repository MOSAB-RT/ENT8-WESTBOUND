-- Anti-Ragdoll
-- =====================================================================
local antiRagdollBodyGyro = nil

RunService.Heartbeat:Connect(function()
    if _G.Settings.AntiRagdoll then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if hum and hrp then
            hum.PlatformStand = false
            if hum:GetState() ~= Enum.HumanoidStateType.Running and hum:GetState() ~= Enum.HumanoidStateType.Freefall then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
            
            if not antiRagdollBodyGyro then
                antiRagdollBodyGyro = Instance.new("BodyGyro")
                antiRagdollBodyGyro.P = 10000
                antiRagdollBodyGyro.D = 100
                antiRagdollBodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
                antiRagdollBodyGyro.Parent = hrp
            end
            antiRagdollBodyGyro.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(hrp.Orientation.Y), 0)
            
            if hrp.Velocity.Y < -50 then
                hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
            end
        end
    else
        if antiRagdollBodyGyro then
            antiRagdollBodyGyro:Destroy()
            antiRagdollBodyGyro = nil
        end
    end
end)

-- =====================================================================
-- Hitbox Extender
-- =====================================================================
local hitboxConnection = nil
local hitboxActive = false
local HitboxData = {}

local function ApplyHitbox(char)
    if not char or char == LocalPlayer.Character then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if not HitboxData[char] then HitboxData[char] = { part = root, size = root.Size, color = root.Color, trans = root.Transparency, mat = root.Material } end
    local size = _G.Settings.HitboxSize
    root.Size = Vector3.new(size, size, size)
    root.CanCollide = false
    root.Transparency = 0.5
    root.Color = _G.Settings.HitboxColor
    root.Material = Enum.Material.Neon
end

local function ResetHitbox(char)
    local data = HitboxData[char]
    if data and data.part and data.part.Parent then
        data.part.Size = data.size
        data.part.CanCollide = true
        data.part.Transparency = data.trans
        data.part.Color = data.color
        data.part.Material = data.mat
    end
    HitboxData[char] = nil
end

local function StartHitboxExtender()
    if hitboxConnection then hitboxConnection:Disconnect() end
    hitboxActive = true
    for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character then ApplyHitbox(p.Character) end end
    hitboxConnection = RunService.Stepped:Connect(function()
        if not hitboxActive then return end
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if not (_G.Settings.TeamCheck and p.Team == LocalPlayer.Team) then ApplyHitbox(p.Character)
                else if HitboxData[p.Character] then ResetHitbox(p.Character) end end
            end
        end
    end)
end

local function StopHitboxExtender()
    hitboxActive = false
    if hitboxConnection then hitboxConnection:Disconnect() hitboxConnection = nil end
    for char, _ in pairs(HitboxData) do ResetHitbox(char) end
    HitboxData = {}
end

local function ToggleHitboxExtender(state)
    _G.Settings.HitboxExtender = state
    if state then StartHitboxExtender() else StopHitboxExtender() end
end

local function UpdateHitboxSize(newSize)
    _G.Settings.HitboxSize = newSize
    if hitboxActive then for char, data in pairs(HitboxData) do if data and data.part and data.part.Parent then data.part.Size = Vector3.new(newSize, newSize, newSize) end end end
end

local function UpdateHitboxColor(newColor)
    _G.Settings.HitboxColor = newColor
    if hitboxActive then for char, data in pairs(HitboxData) do if data and data.part and data.part.Parent then data.part.Color = newColor end end end
end

